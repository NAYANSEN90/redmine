<h2><%= l(:label_llm_chat_new) %></h2>

<%= error_messages_for 'chat' %>

<%= form_for @chat, url: project_llm_chats_path(@project), as: :llm_chat, html: {multipart: false} do |f| %>
  <div class="box tabular">
    <p>
      <%= f.label :title, l(:field_title) %>
      <%= f.text_field :title, size: 60 %>
    </p>
    <p>
      <%= label_tag :prompt, l(:label_llm_first_message) %>
      <%= text_area_tag :prompt, params[:prompt], rows: 8, cols: 60, class: 'wiki-edit' %>
    </p>
  </div>
  <p>
    <%= submit_tag l(:button_create) %>
    <%= link_to l(:button_cancel), project_llm_chats_path(@project) %>
  </p>
<% end %>
